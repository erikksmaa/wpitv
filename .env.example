APP_NAME=WPiTV
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-WPITV-DOMAIN
APP_TIMEZONE=Asia/Jakarta

# Format internasional tanpa tanda +, contoh: 6281234567890
WPITV_WHATSAPP_NUMBER=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wpitv
DB_USERNAME=wpitv_app
DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_UNIQUE_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=30
ADMIN_SESSION_IDLE_TIMEOUT=30
ADMIN_SESSION_ABSOLUTE_LIFETIME=8
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Comma-separated literal hostnames. Do not include schemes or paths.
TRUSTED_HOSTS=YOUR-WPITV-DOMAIN
# Leave blank for direct origin hosting. Set only known proxy/load-balancer IPs or CIDRs.
TRUSTED_PROXIES=

# Keep report-only until browser validation shows no required CSP violations.
SECURITY_CSP_REPORT_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SOCIAL_MEDIA_MANAGER_IDS=
SOCIAL_MEDIA_REVIEWER_IDS=
